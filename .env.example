# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by BOTH the Express backend and the Python ML service (one database,
# one source of truth — the ML service reads existing SCARLET data).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scarlet
DB_USER=scarlet_user
DB_PASSWORD=your_db_password_here

# ─── Express backend ───────────────────────────────────────────────────────────
BACKEND_PORT=4000
# URL the frontend uses to reach the backend
VITE_API_URL=http://localhost:4000

# ─── Python FastAPI ML service ─────────────────────────────────────────────────
ML_SERVICE_PORT=8000
# URL the backend uses to reach the ML service (demand forecasting + health proxy)
ML_SERVICE_URL=http://localhost:8000
# Directory holding the trained demand-model artifacts exported by the notebook.
# Relative paths are resolved against the ml-service/ directory.
DEMAND_MODEL_DIR=models/demand

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Origin allowed to call the backend / ML service. Use the real frontend origin
# in production instead of "*".
FRONTEND_URL=http://localhost:5173

# ─── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
